# Copy this file to `.env` and fill in your key(s). Never commit `.env`.

# Which LLM provider to use for generation. Supported: "anthropic", "openrouter".
# The provider is abstracted behind src/generation.py's LLMClient interface,
# so adding another provider means implementing that interface, not touching
# any other module.
#
# Default is "anthropic" (paid, but highest quality). Set to "openrouter" to
# run entirely on OpenRouter's free-tier models -- no payment method needed.
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here
# Model used for generation. Any current Claude model id works.
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# Free API key, no payment method required: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here
# Any OpenRouter model id that supports tool calling works; ":free" models
# have no cost but are rate-limited. See https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-20b:free
